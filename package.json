{
  "name": "fairturn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 43123",
    "build": "vite build && node scripts/embed-static.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build && node scripts/embed-static.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@vinext/cloudflare": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "type": "module"
}
