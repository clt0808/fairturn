# Copy to .dev.vars for `vite dev` and `wrangler dev`. Do not commit .dev.vars.
# On the deployed Worker these three are secrets, not plain vars.

# Password for /admin. Required before the admin page will accept a login.
ADMIN_PASSWORD=change-me

# Signs the admin cookie. Falls back to ADMIN_PASSWORD if unset.
AUTH_SECRET=change-me-too

# Salt for hashing visitor network addresses. Set a long random value in production.
IP_HASH_SALT=change-me-as-well

# Load four fictional example.com links when the database is empty.
# Leave false on the public Worker. wrangler.jsonc sets SEED_DEMO=false.
# SEED_DEMO=true
